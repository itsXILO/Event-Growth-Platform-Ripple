{
  "name": "ripple-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Event Growth Platform – monorepo root",
  "scripts": {
    "dev": "concurrently --names \"server,client\" --prefix-colors \"cyan,magenta\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "lint": "eslint 'client/src/**/*.{ts,tsx}' 'server/src/**/*.ts'",
    "format": "prettier --write 'client/src/**/*.{ts,tsx,css}' 'server/src/**/*.ts'",
    "db:generate": "npm run db:generate --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:studio": "npm run db:studio --prefix server",
    "db:seed": "npm run db:seed --prefix server"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.8.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.0.0"
  }
}
